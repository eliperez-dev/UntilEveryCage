# Dedicated private geocoding worker image. It contains no Rust server or data
# directories; Compose supplies the database URL and provider credentials.
FROM python:3.12.8-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pipeline/worker-requirements.txt /app/pipeline/worker-requirements.txt
RUN pip install --no-cache-dir -r /app/pipeline/worker-requirements.txt
COPY pipeline /app/pipeline

ENTRYPOINT ["python", "-u", "pipeline/scripts/stages/geocode-worker.py"]

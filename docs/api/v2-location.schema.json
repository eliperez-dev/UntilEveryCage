{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://untileverycage.org/schemas/uec-v2-location-v1.json",
  "title": "Until Every Cage V2 public location",
  "type": "object",
  "additionalProperties": false,
  "required": ["facility_id", "canonical_name", "country_code", "city", "category", "taxonomy_display_category", "taxonomy_primary_categories", "taxonomy_leaf_activities", "taxonomy_assignments", "publication_profile", "factual_review_status", "privacy_screening_status", "project_approval", "reviewer_role", "publication_warning", "display_precision", "geometry_provenance", "latitude", "longitude", "first_observed_at", "last_observed_at", "observation_count", "lifecycle_status", "source_type", "source_rights_status", "provenance_source", "release_id", "release_ruleset_version", "provenance_source_id", "provenance_source_name", "provenance_source_url", "provenance_retrieved_at"],
  "properties": {
    "facility_id": {"type": "string", "format": "uuid"}, "canonical_name": {"type": ["string", "null"]}, "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}, "city": {"type": ["string", "null"]}, "category": {"type": "string"},
    "taxonomy_display_category": {"enum": ["animal_keeping_and_production", "slaughter", "processing_and_preparation", "research_and_animal_use", "other_regulated_premises", "unclassified"]},
    "taxonomy_primary_categories": {"type": "array", "items": {"enum": ["animal_keeping_and_production", "slaughter", "processing_and_preparation", "research_and_animal_use", "other_regulated_premises", "unclassified"]}},
    "taxonomy_leaf_activities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "label"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}}}},
    "taxonomy_assignments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["primary_key", "leaf_key", "leaf_label", "source_code_reference", "source_label_reference", "source_code", "source_label", "method", "status", "taxonomy_version", "crosswalk_version", "ruleset_version"], "properties": {"primary_key": {"enum": ["animal_keeping_and_production", "slaughter", "processing_and_preparation", "research_and_animal_use", "other_regulated_premises", "unclassified"]}, "leaf_key": {"type": ["string", "null"]}, "leaf_label": {"type": ["string", "null"]}, "source_code_reference": {"type": ["string", "null"]}, "source_label_reference": {"type": ["string", "null"]}, "source_code": {"type": ["string", "null"]}, "source_label": {"type": ["string", "null"]}, "method": {"enum": ["direct", "derived", "candidate"]}, "status": {"enum": ["mapped", "partial", "unmapped", "unclassified", "conflicting", "ambiguous"]}, "taxonomy_version": {"type": "string"}, "crosswalk_version": {"type": ["string", "null"]}, "ruleset_version": {"type": ["string", "null"]}}}},
    "publication_profile": {"enum": ["official", "secondary", "community"]}, "factual_review_status": {"type": "string"}, "privacy_screening_status": {"const": "passed"}, "project_approval": {"type": "string"}, "reviewer_role": {"type": ["string", "null"]}, "publication_warning": {"type": ["string", "null"]},
    "display_precision": {"enum": ["exact", "city", "source_reported", "approximate", "unmapped"]},
    "geometry_provenance": {"type": "object", "additionalProperties": false, "required": ["origin"], "properties": {"origin": {"enum": ["source_coordinates", "provider_derived", "verified_coarse_reference", "provider_geocode", "city_reference", "unmapped"]}, "method": {"type": "string"}, "source_precision": {"type": "string"}, "provider": {"type": "string"}, "provider_status": {"type": "string"}, "provider_queried_at": {"type": "string", "format": "date-time"}, "confidence": {"type": "string"}, "confidence_band": {"type": "string"}, "coordinate_review_status": {"type": "string"}, "reference_source_id": {"type": "string"}, "reference_source": {"type": "string"}, "evidence_kind": {"type": "string"}, "evidence_id": {"type": "string"}}},
    "latitude": {"type": ["number", "null"]}, "longitude": {"type": ["number", "null"]}, "first_observed_at": {"type": ["string", "null"], "format": "date-time"}, "last_observed_at": {"type": ["string", "null"], "format": "date-time"}, "observation_count": {"type": ["integer", "null"]},
    "lifecycle_status": {"enum": ["active_observed", "explicitly_closed", "not_seen_recently", "status_unknown"]}, "source_type": {"enum": ["official", "secondary", "user_submitted"]}, "source_rights_status": {"type": "string"}, "provenance_source": {"type": ["string", "null"]}, "release_id": {"type": "string"}, "release_ruleset_version": {"type": "string"}, "provenance_source_id": {"type": "string"}, "provenance_source_name": {"type": "string"}, "provenance_source_url": {"type": "string", "format": "uri"}, "provenance_retrieved_at": {"type": "string", "format": "date-time"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local real-preview candidate",
  "description": "Authenticated local-development DTO only. This schema is not a public API projection or release approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id", "display_name", "activity_label", "activity_source", "source_name",
    "category", "activity_categories", "source_activity_codes", "source_activity_labels",
    "activity_mapping_status", "classification_ruleset_version",
    "taxonomy_display_category", "taxonomy_primary_categories", "taxonomy_leaf_activities", "taxonomy_assignments",
    "source_record_id", "source_url", "source_record_url", "retrieved_at", "observed_at",
    "evidence_summary", "source_id", "location_class", "display_precision", "country_code",
    "city", "postal_code", "latitude", "longitude", "coordinate_precision",
    "coordinate_provenance", "coordinate_review_status", "default_map_scope", "map_scope_reason", "factual_review_status",
    "privacy_screening_status", "project_approval", "publication_status", "preview_label"
  ],
  "properties": {
    "candidate_id": {"type": "string", "format": "uuid"},
    "display_name": {"type": ["string", "null"], "maxLength": 200},
    "activity_label": {"type": ["string", "null"], "maxLength": 240},
    "activity_source": {"type": ["string", "null"], "enum": ["source", null]},
    "source_name": {"type": ["string", "null"], "maxLength": 160},
    "category": {"type": ["string", "null"], "maxLength": 80},
    "activity_categories": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 32},
    "source_activity_codes": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "maxItems": 64},
    "source_activity_labels": {"type": "array", "items": {"type": "string", "maxLength": 5000}, "maxItems": 64},
    "activity_mapping_status": {"enum": ["mapped", "partial", "unmapped", "unclassified", "conflicting", "ambiguous"]},
    "classification_ruleset_version": {"type": ["string", "null"]},
    "taxonomy_display_category": {"enum": ["animal_keeping_and_production", "slaughter", "processing_and_preparation", "research_and_animal_use", "other_regulated_premises", "unclassified"]},
    "taxonomy_primary_categories": {"type": "array", "uniqueItems": true, "maxItems": 6, "items": {"enum": ["animal_keeping_and_production", "slaughter", "processing_and_preparation", "research_and_animal_use", "other_regulated_premises", "unclassified"]}},
    "taxonomy_leaf_activities": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["key", "label"], "properties": {"key": {"type": "string", "maxLength": 200}, "label": {"type": "string", "maxLength": 500}}}},
    "taxonomy_assignments": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["primary_key", "method", "status", "taxonomy_version", "crosswalk_version", "ruleset_version"], "properties": {"primary_key": {"enum": ["animal_keeping_and_production", "slaughter", "processing_and_preparation", "research_and_animal_use", "other_regulated_premises", "unclassified"]}, "leaf_key": {"type": ["string", "null"], "maxLength": 200}, "leaf_label": {"type": ["string", "null"], "maxLength": 500}, "source_code_reference": {"type": ["string", "null"], "maxLength": 500}, "source_label_reference": {"type": ["string", "null"], "maxLength": 500}, "source_code": {"type": ["string", "null"], "maxLength": 1000}, "source_label": {"type": ["string", "null"], "maxLength": 5000}, "method": {"enum": ["direct", "derived", "candidate"]}, "status": {"enum": ["mapped", "partial", "unmapped", "unclassified", "conflicting", "ambiguous"]}, "taxonomy_version": {"type": "string"}, "crosswalk_version": {"type": "string"}, "ruleset_version": {"type": "string"}}}},
    "source_record_id": {"type": "string", "format": "uuid", "description": "Opaque candidate UUID; not the upstream source identifier."},
    "source_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
    "source_record_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence_summary": {"type": ["string", "null"], "maxLength": 500},
    "source_id": {"type": "string"},
    "location_class": {"type": "string"},
    "display_precision": {"type": "string"},
    "country_code": {"type": ["string", "null"], "maxLength": 2},
    "city": {"type": ["string", "null"]},
    "postal_code": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"]},
    "longitude": {"type": ["number", "null"]},
    "coordinate_precision": {"type": ["string", "null"]},
    "coordinate_provenance": {"type": ["string", "null"]},
    "coordinate_review_status": {"type": "string"},
    "default_map_scope": {"type": "boolean"},
    "map_scope_reason": {"type": ["string", "null"]},
    "factual_review_status": {"const": "not_reviewed"},
    "privacy_screening_status": {"const": "pending"},
    "project_approval": {"const": false},
    "publication_status": {"const": "not_published"},
    "preview_label": {"type": "string"}
  }
}

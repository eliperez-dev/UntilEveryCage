{
  "version": "v2",
  "profiles": ["official", "secondary", "community"],
  "endpoints": {
    "GET /health/live": {"success": {"status": "ok", "service": "uec-api"}},
    "GET /health/ready": {"success": {"status": "ready", "database": "ok"}, "unavailable_status": 503},
    "GET /health/diagnostics": {"success": {"status": "ok", "privacy": {"diagnostic_identifiers": "excluded"}}, "payloads": "coarse status only"},
    "GET /api/v2/locations": {"success": {"api_version": "v2", "data": [], "meta": {"profile": "official", "release_id": "string|null", "next_cursor": null, "query": {"q": null, "filters": {}}, "data_product_version": "uec-public-data-product-v1", "schema_version": "uec-location-projection-v1", "coverage_scope": "selected_promoted_release_public_facilities", "count_semantics": "public facility projection rows, not animal counts"}}, "query": ["q", "country_code", "region", "category", "category_keys", "source_type", "profile", "release_id", "display_precision", "lifecycle_status", "cursor", "offset", "limit", "min_lon", "min_lat", "max_lon", "max_lat", "latitude", "longitude", "radius_km"], "pagination": {"cursor": "preferred; facility_id continuation token scoped to release_id", "offset": "retained for compatibility; bounded 0..1000000", "limit": "defaults to 100; bounded 1..1000", "mutually_exclusive": ["cursor", "offset"]}, "spatial": "bbox or radius, never both", "no_release": 200, "pinned_release_withdrawn": 410},
    "GET /api/v2/locations/{facility_id}": {"success": {"api_version": "v2", "data": {}, "meta": {"coverage_scope": "selected_promoted_release_public_facilities", "count_semantics": "public facility projection, not an animal count"}}, "query": ["profile", "release_id"], "not_found_or_suppressed": 404, "pinned_release_withdrawn_or_mismatched": 410},
    "GET /api/v2/locations.csv": {"success_content_type": "text/csv", "bounded_rows": 1000, "profile_required_for_nonofficial": true, "not_found_without_promoted_manifest": 404, "row_contract": "docs/data-dictionary.json", "rights_field": "source_rights_status"},
    "bulk_snapshot_cli": {"command": "pipeline/scripts/stages/export-release.py RELEASE_ID --profile PROFILE --output-dir DIR", "formats": ["csv", "geojson"], "artifacts": ["manifest.json", "SHA256SUMS.json", "data-dictionary.json"], "gate": "explicitly promoted non-test release/profile and release-scoped public projection"},
    "GET /api/v2/releases/manifest": {"success": {"api_version": "v2", "data": {"release_id": "string", "profile": "string", "manifest": {"map_artifact": "versioned release/profile MVT inventory"}, "manifest_sha256": "sha256", "suppression_generation": "integer"}}, "etag": "manifest digest plus current suppression generation", "cache_control": "public, max-age=0, must-revalidate", "conditional_304": true, "not_found_without_promoted_manifest": 404},
    "GET /api/v2/releases/{release_id}/map/tiles/{z}/{x}/{y}.mvt": {"success_content_type": "application/vnd.mapbox-vector-tile", "query": ["profile"], "source_layer": "uec_map", "feature_schema_version": "uec-map-feature-v1", "feature_properties": ["feature_key", "kind", "count", "exact_count", "coarse_count", "next_zoom", "record_id (exact leaves only)", "category_key"], "eligibility": "promoted release/profile, canonical manifest, current suppression generation, inventoried tile checksum", "etag": "sha256 of tile bytes", "cache_control": "public, max-age=0, must-revalidate", "unavailable_after_withdrawal_or_suppression": 410},
    "GET /api/v2/discovery/filters": {"success": {"api_version": "v2", "contract_version": "v1", "dimensions": {"country_code": "allowlist", "region": "release facets", "category": "allowlist", "source_type": "allowlist", "profile": "allowlist", "display_precision": "allowlist", "lifecycle_status": "allowlist"}, "search": {"fields": ["canonical_name", "city", "country_code", "category", "source_name"]}, "spatial": {"bbox": ["min_lon", "min_lat", "max_lon", "max_lat"], "radius": ["latitude", "longitude", "radius_km"]}, "pagination": {"cursor": "preferred", "offset": "compatibility only", "limit_max": 1000}}}
    ,"GET /api/dev/preview/candidates": {"success": {"api_version": "dev-preview-v1", "data": [], "meta": {"test_only": true, "private_preview": true, "profile": null, "coverage_scope": "candidate_release_only", "next_cursor": null}}, "auth_header": "X-UEC-Dev-Preview-Token", "production": "unavailable"}
    ,"GET /api/v2/discovery/facets": {"success": {"api_version": "v2", "meta": {"profile": "official", "release_id": "string", "ruleset_version": "string", "release_created_at": "timestamp", "coverage_scope": "selected_promoted_release_public_facilities", "count_semantics": "eligible public facility projection rows after current suppression; not story-wide or animal counts", "filters": {}}, "dimensions": {}}, "max_values_per_dimension": 20, "counts_are_from": "selected eligible promoted public projection"},
    "GET /api/v2/graph/connections": {"success": {"api_version": "v2-graph-v1", "data": "release-scoped exact and inferred public connections", "meta": {"profile": "official", "release_id": "string", "ruleset_version": "string", "limit": "1..100", "page_max": 100, "next_cursor": "uuid|null", "confidence_kind": "ruleset_estimate_not_probability", "public_projection": true, "human_confirmed_state": false}}, "query": ["profile", "connection_type", "min_confidence", "max_confidence", "confidence_band", "include_conflicting", "source_id", "entity_id", "cursor", "limit"], "not_found_without_promoted_release": 404},
    "GET /api/v2/graph/entities": {"success": {"api_version": "v2-graph-v1", "data": "release-scoped public facilities and eligible organizations", "meta": {"profile": "official", "release_id": "string", "ruleset_version": "string", "limit": "1..100", "page_max": 100, "next_cursor": "uuid|null", "public_projection": true}}, "query": ["profile", "q", "entity_type", "cursor", "limit"], "not_found_without_promoted_release": 404},
    "GET /api/v2/graph/entities/{entity_id}/neighborhood": {"success": {"api_version": "v2-graph-v1", "data": "release-scoped public connections adjacent to an entity", "meta": {"profile": "official", "release_id": "string", "ruleset_version": "string", "public_projection": true}}, "query": ["profile", "connection_type", "min_confidence", "max_confidence", "confidence_band", "include_conflicting", "source_id", "cursor", "limit"], "not_found_without_promoted_release": 404}
  },
  "error": {"shape": {"api_version": "v2", "error": {"code": "string", "message": "string"}}, "codes": ["invalid_filter", "invalid_profile", "invalid_source_type", "invalid_display_precision", "invalid_lifecycle_status", "invalid_limit", "invalid_offset", "invalid_cursor", "invalid_pagination", "invalid_spatial_query", "invalid_map_tile", "database_not_configured", "database_pool_unavailable", "database_transaction_unavailable", "release_query_failed", "release_not_found", "release_unavailable", "read_model_unavailable", "location_query_failed", "facets_query_failed", "export_query_failed", "export_too_large", "export_encoding_failed", "database_transaction_failed", "release_manifest_unavailable", "release_manifest_invalid", "suppression_generation_unavailable", "map_artifact_unavailable", "map_artifact_invalid", "map_artifact_not_found", "map_artifact_revoked", "map_tile_not_found", "location_not_found", "rate_limited"]},
  "community_pilot": {
    "enabled_by_default": false,
    "runtime": "development loopback only; production refused",
    "policy": "docs/governance/user-submitted-data.md",
    "submission": {
      "route": "POST /api/community/submissions",
      "body_max_bytes": 12288,
      "deny_unknown_fields": true,
      "kinds": [
        "facility",
        "evidence",
        "correction",
        "duplicate",
        "privacy_removal"
      ],
      "required_for_all": [
        "kind",
        "consent=true"
      ],
      "required_by_kind": {
        "facility": [
          "label"
        ],
        "evidence": [
          "target_record_id",
          "source_url or description"
        ],
        "correction": [
          "target_record_id",
          "description"
        ],
        "duplicate": [
          "target_record_id",
          "duplicate_record_id (distinct)"
        ],
        "privacy_removal": [
          "target_record_id",
          "description"
        ]
      },
      "optional_field_bounds": {
        "label": 160,
        "country_code": "optional ISO alpha-2; omitted or unknown means absent stored country",
        "locality": 160,
        "claimed_activity": 160,
        "location_text": 1000,
        "description": 2000,
        "source_url": 2048,
        "contact_email": 254
      },
      "location": {
        "coordinates": "paired finite WGS84; restricted",
        "claimed_precision": [
          "unknown",
          "exact",
          "coarse",
          "unmapped"
        ],
        "location_input_method": [
          "manual_pin",
          "text",
          "unknown"
        ]
      },
      "success_fields": [
        "submission_id",
        "receipt_secret",
        "status"
      ],
      "creates_release_membership": false,
      "fetches_source_urls": false
    },
    "status": {
      "route": "POST /api/community/status",
      "required": [
        "submission_id",
        "receipt_secret"
      ],
      "success_fields": [
        "submission_id",
        "status",
        "public_record_url (optional live eligible link)"
      ],
      "failure_status": 404
    },
    "operator": {
      "credential": "distinct bearer token; never receipt/preview token",
      "queue": "GET /api/private/community/submissions",
      "queue_default": "received or held; up to50; optional explicit status",
      "disposition": "POST /api/private/community/submissions/{id}/disposition",
      "actions": [
        "hold",
        "screen",
        "reject",
        "restrict",
        "remove",
        "link_community"
      ],
      "link_id": "existing released source-record UUID, not facility UUID",
      "maintenance": "POST /api/private/community/maintenance; external scheduler required"
    },
    "public": {
      "separately_enabled": true,
      "routes": [
        "GET /api/community/claims",
        "GET /api/community/claims/{id}"
      ],
      "required_query": [
        "profile=community",
        "release_id"
      ],
      "max_linked_candidates": 500,
      "excess_status": 503,
      "success_fields": [
        "submission_id",
        "kind",
        "record_id",
        "release_id",
        "public_record_url",
        "origin",
        "factual_review_status",
        "project_approval",
        "warning"
      ],
      "origin": "community-submitted",
      "factual_review_status": "unreviewed",
      "project_approval": "not-approved",
      "new_submitted_pins_published": false
    },
    "responses": {
      "cache_control": "no-store",
      "referrer_policy": "no-referrer"
    },
    "launch_gaps": [
      "scheduled expiry",
      "approved triage/retention/terms",
      "least-privilege database roles",
      "submission removal restore/replay",
      "new screened derivative release handoff"
    ]
  },
  "privacy": "Public responses contain eligible released projection fields; screened unreviewed community claims carry persistent warnings. Restricted records and raw intake are never returned."
}
